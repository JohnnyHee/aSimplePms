# ---- 本项目在受限沙箱 / 无管理员权限的 Windows 会话下的必要设置 ----

# 1) 该会话无法创建符号链接（New-Item -ItemType SymbolicLink 报
#    "Administrator privilege required"，即未开启开发者模式且非管理员），
#    pnpm 默认的 isolated 链接方式会失败：ERR_PNPM_SYMLINK_FAILED [symlinkAllModules]。
#    改用 hoisted 布局（硬链接在当前文件系统可用）。正常开发机上可删除此行恢复默认布局。
node-linker=hoisted

# 2) 关闭“运行脚本前自动校验并补装依赖”。沙箱禁止写入
#    %LOCALAPPDATA%\pnpm-store-operation-locks（pnpm 的 store 操作锁），
#    自动安装必然失败并连带让 `pnpm run <script>` 直接报错退出。
#    pnpm 10 会读取本文件；pnpm 12 只认命令行开关，需要写成
#    `pnpm --config.verify-deps-before-run=false <script>`。
verify-deps-before-run=false
